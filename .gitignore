# Component repos — each is its own independently published repository.
# This umbrella repo links to them; it does not contain them (no submodules).
/atrocore-docker/
/compliance_cmis/
/compliance_flow/
/compliance_import/
/compliance_web/
/compliance_checklist/

# Internal-only documentation and tooling — never published here.
# Any future internal-only doc goes in internal/, no per-file entry needed.
/internal/

# Local tooling/scratch directories.
/.claude/
/.e2e-tools/
/.footprint-audit/
/.glab-config/

# backup sets produced by atrocore-docker/scripts/backup-platform.sh, whose
# default destination is this directory. They are database dumps, physical
# base backups and the Alfresco content store -- hundreds of MB of binary,
# containing whatever the running instance held. They were committed here
# once, by a `git add -A` in this repo right after a backup run, and caught
# before anything was pushed.
backups/
